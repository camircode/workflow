# Copy to .env for local development. Placeholders only — never real values.
#
# In this project's deployed form none of this is authored by hand: DATABASE_URL
# is a Kubernetes Secret rendered from Bitwarden Secrets Manager, and NOTIFY_URL
# is a ConfigMap because it is configuration, not a secret.
#
# Locally, prefer `bws run -- pnpm dev` over a .env holding a real password.

# PostgreSQL connection string.
DATABASE_URL=postgresql://workflow:CHANGEME@localhost:5432/workflow

# Where the archived-task notification is POSTed. Required.
# The external system does not need to exist for the API to work — failed
# attempts are recorded and readable at GET /tasks/:idTask/notifications.
NOTIFY_URL=https://example.invalid/hooks/task-archived

# Port the HTTP server listens on.
PORT=8080
