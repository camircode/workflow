{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    // Named explicitly rather than left to the automatic scan of node_modules/@types,
    // which pulls in every package that happens to be installed there.
    "types": ["node"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "verbatimModuleSyntax": true,

    "noEmit": true,
    "sourceMap": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src", "tests", "vitest.config.ts"]
}
