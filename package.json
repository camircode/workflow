{
  "name": "workflow",
  "version": "1.0.0",
  "private": true,
  "description": "Work management API: tasks assigned to several people, archived when every one of them is done.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.20.0",
  "imports": {
    "#*": {
      "development": "./src/*",
      "default": "./dist/*"
    }
  },
  "scripts": {
    "dev": "tsx watch --conditions development src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "db:migrate": "tsx --conditions development src/infrastructure/db/migrate.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fastify/swagger": "^9.8.1",
    "@fastify/swagger-ui": "^6.1.1",
    "fastify": "^5.12.1",
    "fastify-type-provider-zod": "^7.0.0",
    "pg": "^8.23.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^12.1.0",
    "@types/node": "^26.3.0",
    "@types/pg": "^8.23.1",
    "openapi-types": "^12.1.3",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
